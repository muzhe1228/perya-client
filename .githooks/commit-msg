#!/bin/sh
# 提交说明须含简体中文（与 .cursor/rules/git-commit-zh.mdc 一致）。
# 跳过：git commit --no-verify（不建议）
MSG_FILE="$1"
if [ ! -f "$MSG_FILE" ]; then
  exit 0
fi

subject=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    "" | \#*) continue ;;
    *) subject="$line"; break ;;
  esac
done < "$MSG_FILE"

if [ -z "$subject" ]; then
  echo "[commit-msg] ❌ 提交说明为空。"
  exit 1
fi

body=$(printf '%s\n' "$subject" | sed -E \
  's/^(feat|fix|refactor|chore|docs|merge|style|test|perf|build|ci)(\([^)]+\))?:[[:space:]]*//I')

if ! node -e "process.exit(/[\u4e00-\u9fff]/.test(process.argv[1])?0:1)" "$body" 2>/dev/null; then
  echo ""
  echo "[commit-msg] ❌ 提交说明须使用简体中文（见 .cursor/rules/git-commit-zh.mdc）。"
  echo "            当前 subject: $subject"
  echo "            示例: feat: 修正 BonusBetInfo 均注与总注额精度"
  echo "            确需跳过: git commit --no-verify"
  exit 1
fi

exit 0
