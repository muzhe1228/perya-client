#!/bin/sh
# 提交前类型检查（与 npm run build 的第一步一致）：失败则阻断提交。
# 临时跳过：git commit --no-verify（不建议，错误会留到打包时才暴露）
echo "[pre-commit] 运行类型检查（npm run type-check）..."
npm run type-check
if [ $? -ne 0 ]; then
  echo ""
  echo "[pre-commit] ❌ 类型检查未通过，提交已阻断。"
  echo "            修复上方错误后重新提交；确需跳过：git commit --no-verify"
  exit 1
fi
echo "[pre-commit] ✅ 类型检查通过"
exit 0
